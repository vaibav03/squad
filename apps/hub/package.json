{
  "name": "@squad/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./real": "./src/wire.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --passWithNoTests",
    "test:smoke": "vitest run --dir test/smoke --passWithNoTests",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "load": "tsx scripts/load.ts",
    "test:security": "vitest run --dir test/security --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@hono/node-server": "^2.1.5",
    "@squad/bot": "workspace:*",
    "@squad/brain": "workspace:*",
    "@squad/core": "workspace:*",
    "@squad/media": "workspace:*",
    "@squad/mesh": "workspace:*",
    "hono": "^4.13.13",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2"
  }
}
