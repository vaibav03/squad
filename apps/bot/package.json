{
  "name": "@squad/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --passWithNoTests",
    "test:smoke": "vitest run --dir test/smoke --passWithNoTests",
    "dev": "tsx src/main.ts",
    "chat": "TRANSPORT=cli tsx src/main.ts",
    "scheduler": "tsx src/scheduler/cli.ts"
  },
  "dependencies": {
    "@photon-ai/imessage-kit": "^3.0.0",
    "@squad/brain": "workspace:*",
    "@squad/core": "workspace:*",
    "@squad/media": "workspace:*",
    "@squad/mesh": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "fast-check": "^4.10.2"
  }
}
