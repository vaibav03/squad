# Copy to .env (never commit .env). Docker compose reads it automatically; images never contain it.
# Audit: every variable the product reads is listed here (grep process.env / import.meta.env).

# ---- Required for any deployment ----
# Shared secret for POST /internal/events (hub, agents, bot). Generate: openssl rand -hex 32
# Must not be "change-me": `pnpm preflight` and docker compose both refuse the default.
INTERNAL_EVENTS_SECRET=change-me
# Signs login/stream tokens. Defaults to a value derived from INTERNAL_EVENTS_SECRET; set your own in prod.
HUB_AUTH_SECRET=

# ---- Providers (leave blank for the offline demo model) ----
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Model overrides (defaults are set in packages/core/src/llm/gemini.ts):
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_MAIN=gemini-3.8-flash
# GEMINI_MODEL_CHAIR=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=
# ELEVENLABS_VOICE_ID=           # a voice you own: used first, works on plans that block library voices
# ELEVENLABS_FALLBACK_VOICE_ID=
# SQUAD_TTS_CONCURRENCY=
# FFMPEG_PATH=            # only if ffmpeg is not on PATH (the hub image ships it)
# GOOGLE_ACCESS_TOKEN=    # agents: optional Google Calendar access

# ---- Hub ----
HUB_BASE_URL=http://localhost:8788   # public URL of the hub (compose sets it from PUBLIC_ORIGIN)
# HUB_PORT=8788
DB_PATH=data/squad.db                # compose uses /data/squad.db on a volume
# HUB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173   # comma list; unneeded on one origin
# HUB_SEED=1             # demo roster + dev-login (1 until real accounts exist)
# HUB_SIM=0              # simulator endpoints (/__sim); never in production
# HUB_LOG=info
# HUB_REPLAY_DIR=
# FORCE_FAKE_LLM=1       # keep ports real but the model fake
# NODE_ENV=production
# LOG_LEVEL=info

# ---- Agents / bot ----
# AGENT_PEERS=s_ana=http://localhost:4101,...   # hub's view of the agents
# PEERS=...                                      # an agent's view of its peers
# AGENT_ID=s_ana  PORT=4101  AGENT_SEED=  AGENTS_FIXTURES=  FAKE_LLM=0  CONFIRM_MODE=web
# TRANSPORT=cli          # cli | discord | imessage
# DISCORD_TOKEN=
# BOT_PORT=8790  BOT_URL=

# ---- Web host (build time, Vite) ----
# VITE_HUB_URL=http://localhost:8788   # docker image uses a runtime sentinel replaced by PUBLIC_ORIGIN

# ---- Docker compose (deploy) ----
# PUBLIC_ORIGIN=http://localhost:8080  # the one origin users type; set https://your.domain in prod
# WEB_PORT=8080
# BIND_ADDR=127.0.0.1                  # 0.0.0.0 for LAN demo mode
# SQUAD_TAG=local
# AGENT_FAKE_LLM=0

# ---- Dev / test / demo scripts ----
# SQUAD_LIVE=1           # tiny-budget real-key smoke scripts and `pnpm doctor` live checks
# DEV_ALL_HUB_PORT=8788  DEV_ALL_WEB_PORT=5180
# SQUAD_ROOT=            # override repo root (media assets)

# ---- Deploy tooling and test/eval knobs (all optional) ----
# SQUAD_SOURCEMAP=1       # emit source maps in the web build (never ship them publicly)
# WEB_DIST=apps/web-host/dist   # bundle-size report input
# HUB_UPSTREAM=hub:8788   # web (nginx) container: where /v1 is proxied
# VITE_HUB_BASE_URL=      # legacy alias of VITE_HUB_URL
# CONFIRM_ANSWERS=s_ben=no,s_cam=timeout   # scripted agent confirmations
# DEMO_DEBUG=  DEMO_LIVE_LLM=  DEV_ALL_AGENT_PORT_BASE=  ROOMS=  ROOMS_B_LIVE=
# BRAIN_REAL_EVAL=1  BRAIN_EVAL_MAX_CALLS=   # real-key brain evals
# ROUND= THEMES= TIMES= CLIENTS= DURATION= ONLY=   # load/e2e script parameters
