# Copy to .env (never commit .env). Bot, agents, experts and council use Gemini; voices use ElevenLabs.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional model overrides (defaults are set in packages/core/src/llm/gemini.ts):
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_MAIN=gemini-3.8-flash
# GEMINI_MODEL_CHAIR=gemini-3.8-flash
HUB_BASE_URL=http://localhost:8788
# Shared secret for POST /internal/events (the hub and every emitter read this name):
INTERNAL_EVENTS_SECRET=change-me
DB_PATH=data/squad.db
# Set to 1 to run the tiny-budget real-key smoke scripts:
SQUAD_LIVE=
