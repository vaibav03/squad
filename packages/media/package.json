{
  "name": "@squad/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sprites": "./src/sprites/index.ts",
    "./personas": "./src/personas/index.ts",
    "./portraits": "./src/portraits/index.ts",
    "./gif": "./src/gif/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --passWithNoTests",
    "test:smoke": "vitest run --dir test/smoke --passWithNoTests",
    "build:sprites": "python3 src/sprites/build/build_cast.py && python3 src/portraits/build_portraits.py",
    "build:gifs": "tsx src/gif/buildGif.ts",
    "build:wall": "python3 src/sprites/wall/build_wall.py",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "design-voices": "tsx scripts/design-voices.ts"
  },
  "dependencies": {
    "@squad/core": "workspace:*",
    "zod": "^4.6.7",
    "@google/genai": "^1.52.0",
    "sharp": "^0.35.5"
  }
}
