{
  "name": "@squad/brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fake-servers": "./src/context/parity/fake-servers.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir src --passWithNoTests && vitest run --dir evals --passWithNoTests",
    "test:smoke": "vitest run --dir test/smoke --passWithNoTests",
    "eval": "vitest run --dir evals --passWithNoTests",
    "eval:real": "BRAIN_REAL_EVAL=1 tsx --env-file=../../.env evals/real-key-eval.ts"
  },
  "dependencies": {
    "@squad/core": "workspace:*",
    "unpdf": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
