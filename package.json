{
  "name": "squad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "pnpm -r run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "dev": "pnpm -r --parallel --if-present run dev",
    "bot:chat": "pnpm --filter @squad/bot chat",
    "bot:scheduler": "pnpm --filter @squad/bot scheduler",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:reset": "tsx scripts/demo/reset.ts",
    "demo:replay": "tsx scripts/demo/replay.ts",
    "demo:preflight": "tsx scripts/demo/preflight.ts",
    "demo:live": "tsx scripts/demo/live.ts",
    "dev:all": "tsx scripts/dev/all.ts",
    "live:verify": "tsx scripts/live/verify.ts",
    "live:images": "python3 scripts/live/make_images.py",
    "doctor": "tsx scripts/doctor.ts",
    "squad:doctor": "tsx scripts/doctor.ts",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @squad/web-host build",
    "bundle:report": "tsx scripts/deploy/bundle-size.ts",
    "preflight": "tsx scripts/deploy/preflight.ts",
    "security:scan": "tsx scripts/security/scan.ts",
    "perf:check": "node scripts/perf/check.mjs",
    "perf:bundle": "node scripts/perf/bundle.mjs",
    "perf:runtime": "node scripts/perf/runtime.mjs",
    "perf:hub": "tsx scripts/perf/hub-bench.ts",
    "perf:psi": "tsx scripts/perf/psi-profile.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
